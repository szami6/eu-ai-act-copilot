# vLLM serving flags for the `llm-gpu` compose service — loaded as plain
# container env vars and expanded into the `vllm serve` command in
# docker-compose.yml. One place to tune (PLAN.md §4.4).
#
# VERIFY on the GPU box during the Phase 0 spike: the exact vllm/vllm-openai
# image tag, driver >= R570 for Blackwell (sm_120), CUDA 12.8+ compatibility,
# and that every flag below is still spelled the same way in
# `docker compose --profile gpu run --rm llm-gpu vllm serve --help` for
# whatever version gets pinned. The `latest` tag in docker-compose.yml is a
# placeholder — pin it once a working tag is confirmed and note it here.

# --- quality profile (default): Qwen3-8B-FP8, near-lossless, ~8.5 GB weights ---
MODEL=Qwen/Qwen3-8B-FP8

# --- throughput profile: swap to this for ~1.5x single-stream decode and
# ~2x KV headroom, at a quality cost measured in the eval ablation (PLAN.md
# §7.4) rather than assumed. Comment the line above and uncomment this one. ---
# MODEL=Qwen/Qwen3-8B-AWQ

MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.85
KV_CACHE_DTYPE=fp8
MAX_NUM_SEQS=32
